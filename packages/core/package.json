{
  "name": "@loupe/core",
  "private": true,
  "version": "0.1.0",
  "description": "Shared annotation UI components used by Loupe extension and dev-annotator SDK. Internal monorepo package — bundled into @loupe/dev-annotator at build time; not published to npm.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./globals.css": "./src/globals.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.0.0"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "vitest": "^3.0.0"
  }
}
