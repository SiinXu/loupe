{
  "name": "loupe-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Loupe — inspect, annotate, and fix any web UI with AI. Browser extension + drop-in SDK for Electron / web apps.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Siin Xu",
  "homepage": "https://github.com/SiinXu/loupe",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiinXu/loupe.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @loupe/core build",
    "build:extension": "pnpm --filter @loupe/extension build",
    "build:sdk": "pnpm --filter @loupe/dev-annotator build",
    "dev:extension": "pnpm --filter @loupe/extension dev"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.32.1"
}
